<?xml version="1.0" encoding="utf-8"?>
<!-- Same layers as ic_launcher.xml — see the note there. The <monochrome>
     must be present here too: the manifest declares android:roundIcon, and a
     monochrome layer on only one of the two does not enable themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
