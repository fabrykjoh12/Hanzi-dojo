<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch background, light. Must equal SPLASH_BG.light in
         src/splashIntro.js and the light splash drawables, or the handoff from
         the system splash to the app's own launch animation flashes. -->
