    <!-- The Capacitor scaffold's styles.xml references these three but never
         shipped a colors.xml to define them; they resolve only because
         AppTheme is unused in practice (MainActivity uses
         AppTheme.NoActionBarLaunch). Defined here so the file is honest. -->
    <color name="colorPrimary">#B83A24</color>
    <color name="colorPrimaryDark">#922E1C</color>
    <color name="colorAccent">#B83A24</color>
</resources>
