{
  "name": "hanzi-dojo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit:stories": "node --env-file=.env.script audit-story-coverage.mjs",
    "build": "vite build",
    "build:native": "cross-env DOJO_PUBLIC_BUILD=1 DOJO_NATIVE_BUILD=1 vite build",
    "build:public": "cross-env DOJO_PUBLIC_BUILD=1 vite build",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:sync": "npm run build:native && cap sync",
    "db:generate": "drizzle-kit generate",
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "dojo": "node tools/dojo-run.mjs",
    "dojo:bridge": "node tools/dojo-bridge.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "tts:dry-run": "node --env-file=.env.script tts-generate.mjs",
    "tts:generate": "node --env-file=.env.script tts-generate.mjs",
    "tts:integration": "node --env-file=.env.script tts-integration-check.mjs",
    "tts:retry-failed": "node --env-file=.env.script tts-generate.mjs --retry-failed",
    "verify:native": "node tools/verify-native-shell.mjs && npm run build:native && npm run verify:native-fonts",
    "verify:native-fonts": "node tools/verify-native-fonts.mjs",
    "verify:pr": "npm run lint && npm test && npm run build && npm run build:public && npm run verify:public-bundle && node tools/verify-app-icons.mjs",
    "verify:tasks": "node tools/verify-task-contracts.mjs",
    "verify:review": "vitest run review-protocol.test.mjs",
    "verify:public-bundle": "node tools/verify-public-bundle.mjs"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.107.0",
    "hanzi-writer": "^3.7.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "ts-fsrs": "^5.4.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "openai": "^6.42.0",
    "opencc-js": "^1.4.1",
    "pinyin-pro": "^3.28.1",
    "postcss": "^8.5.15",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "web-push": "^3.6.7"
  }
}
